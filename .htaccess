Options -MultiViews
RewriteEngine On
# force https + no www (skip SSL validation files)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://anasercer.com%{REQUEST_URI} [R=301,L]
# old theme demo pages and the /new/ staging copy go to the live pages
RewriteRule ^index-(?:[0-9]+-)?white\.html$ / [R=301,L]
RewriteRule ^index-[0-9]+\.html$ / [R=301,L]
RewriteRule ^new/?(.*)$ /$1 [R=301,L]
# serve /page as /page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
# redirect /page.html to /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %1 !(^|/)index$
RewriteCond %1 !^google[0-9a-f]+$
RewriteRule ^ %1 [R=301,L,NE]

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType video/mp4 "access plus 6 months"
ExpiresByType video/webm "access plus 6 months"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_mime.c>
AddType video/webm .webm
AddType font/woff2 .woff2
</IfModule>
